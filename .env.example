# ============================================================================
# LabPath PostgreSQL Database Configuration (100% Portable: Neon.tech OR Supabase)
# ============================================================================
# Option A: Neon.tech (Recommended Free Tier - supports 10+ projects, no 7-day pause)
# DATABASE_URL="postgresql://neondb_owner:password@ep-cool-lab-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Option B: Supabase PostgreSQL (Transaction/Session Pooler URL)
# DATABASE_URL="postgresql://postgres.projectref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

DATABASE_URL="postgresql://user:password@localhost:5432/labpath"

# Optional Public API URL when running backend routes
EXPO_PUBLIC_API_URL="http://localhost:8081"
